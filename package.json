{
  "name": "nestjs-api-forge",
  "version": "2.0.0",
  "description": "Standardized API response formatting, error handling, and exception filters for NestJS applications",
  "author": "Mirza Saikat Ahmmed",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "clean": "node -e \"require(\\\"fs\\\").rmSync(\\\"dist\\\",{recursive:true,force:true})\"",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "lint:check": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "jest",
    "test:cov": "jest --coverage",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "docs": "typedoc",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "nestjs",
    "api",
    "error-handling",
    "response-formatter",
    "exception-filter",
    "interceptor",
    "rest-api",
    "standardized-response"
  ],
  "peerDependencies": {
    "@nestjs/common": "^9.0.0 || ^10.0.0 || ^11.0.0 || ^12.0.0",
    "@nestjs/core": "^9.0.0 || ^10.0.0 || ^11.0.0 || ^12.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "rxjs": "^7.0.0"
  },
  "devDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/testing": "^11.2.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "eslint": "^10.4.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.9",
    "reflect-metadata": "^0.1.14",
    "rxjs": "^7.8.0",
    "ts-jest": "^29.4.14",
    "typedoc": "^0.28.20",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.59.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirzasaikatahmmed/nestjs-api-forge.git"
  },
  "bugs": {
    "url": "https://github.com/mirzasaikatahmmed/nestjs-api-forge/issues"
  },
  "homepage": "https://github.com/mirzasaikatahmmed/nestjs-api-forge#readme"
}
