root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# These files are committed with CRLF line endings
[{package.json,package-lock.json,.gitignore}]
end_of_line = crlf
